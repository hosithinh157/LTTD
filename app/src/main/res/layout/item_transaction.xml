<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Vòng tròn icon danh mục -->
    <FrameLayout
        android:id="@+id/bgCategoryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_soft">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_sort_by_size" />
    </FrameLayout>

    <!-- Tên giao dịch & Danh mục • Giờ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTransNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cà phê Highlands"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Ăn uống • 08:30"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Số tiền -->
    <TextView
        android:id="@+id/tvTransAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-45.000 đ"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>