<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavHistory"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp">

        <!-- 1. Top App Bar: SmartFinance / Lịch sử -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_logo_green">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="SmartFinance"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="/ Lịch sử"
                android:textColor="#475569"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#0F172A" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="#E2E8F0"
                android:padding="6dp"
                android:src="@drawable/ic_person" />
        </LinearLayout>

        <!-- 2. Thanh tìm kiếm (Tìm theo tên quán, số tiền...) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#334155" />

            <EditText
                android:id="@+id/edtSearchHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tìm theo tên quán, số tiền..."
                android:inputType="text"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivFilterReset"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#0F172A" />
        </LinearLayout>

        <!-- 3. Bộ lọc loại giao dịch (Tất cả | Chi | Thu) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_income"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Tất cả"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterExpense"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Chi"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterIncome"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Thu"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Thẻ Tổng chi & Tổng thu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_white"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng chi"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHistoryTotalExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-7.650.000 đ"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E2E8F0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng thu"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHistoryTotalIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+18.500.000 đ"
                    android:textColor="#066843"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Danh sách giao dịch gom nhóm theo ngày -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistoryGroups"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

    <!-- 6. Thanh Bottom Navigation (Tab Lịch sử đang được tô xanh) -->
    <RelativeLayout
        android:id="@+id/bottomNavHistory"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navHomeFromHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠\nTrang chủ"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🧾\nLịch sử"
                android:textColor="#066843"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/navBudgetFromHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🐷\nNgân sách"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navReportFromHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="◔\nBáo cáo"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fabAddFromHistory"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_circle_soft"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>

</RelativeLayout>